# ==============================================================================
# Uptime Kuma 環境變數範本（Synology DS718+ 2GB RAM + Tailscale）
# 使用前請執行：cp .env.example .env
# ==============================================================================

# 時區與監聽設定（預設 3001，避開 novel 3000、homepage 3010、LibreTV 8080、vaultwarden 8200）
TZ=Asia/Taipei
UPTIME_KUMA_BIND_IP=0.0.0.0
UPTIME_KUMA_PORT=3001

# 映像檔版本鎖定（選填，預設使用不含 Chromium 的 2-slim 輕量版）
# UPTIME_KUMA_IMAGE=ghcr.io/louislam/uptime-kuma:2-slim
