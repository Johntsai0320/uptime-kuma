# ==============================================================================
# Uptime Kuma 環境變數範本（Synology DS718+ 2GB RAM + Tailscale）
# 使用前請執行：cp .env.example .env
# ==============================================================================

# 時區與監聽設定（預設 3001，避開 novel 3000、homepage 3010、LibreTV 8080、vaultwarden 8200）
TZ=Asia/Taipei
UPTIME_KUMA_BIND_IP=0.0.0.0
UPTIME_KUMA_PORT=3001

# Node.js V8 堆積記憶體上限（MB）；搭配 compose mem_limit: 256m 防止 2GB RAM 機型發生 HDD Swap
NODE_OPTIONS=--max-old-space-size=192

# 映像檔版本鎖定（選填，預設拉取本倉庫 CI 自動發布的 ghcr.io/johntsai0320/uptime-kuma:latest）
# 亦可指定為官方上游輕量版：UPTIME_KUMA_IMAGE=ghcr.io/louislam/uptime-kuma:2-slim
# UPTIME_KUMA_IMAGE=ghcr.io/johntsai0320/uptime-kuma:latest
